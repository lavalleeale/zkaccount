{
  "name": "zk-google-4337",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "fetch:google-jwks": "tsx scripts/fetch-google-jwks.ts",
    "typecheck:cre": "npm run typecheck --prefix cre/google-jwks",
    "circuit:fixture": "tsx circuits/scripts/generate-fixture.ts",
    "circuit:test-negative": "tsx circuits/scripts/test-negative.ts",
    "circuit:test-bbjs": "tsx circuits/scripts/test-bbjs.ts",
    "circuit:generate-verifier": "tsx circuits/scripts/generate-verifier.ts",
    "sdk:test": "npm test -w @zkaccount/sdk",
    "dev:a": "npm run dev -w @zkaccount/demo-a",
    "dev:b": "npm run dev -w @zkaccount/demo-b"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.3.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.68.0",
    "viem": "^2.37.3"
  },
  "dependencies": {
    "@zkpassport/poseidon2": "^0.6.2"
  }
}
